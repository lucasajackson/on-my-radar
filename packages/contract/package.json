{
  "name": "@onmyradar/contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./dist/snapshot-cli.js"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "snapshot": "tsc -p tsconfig.json && node dist/snapshot-cli.js"
  },
  "dependencies": {
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "micromark-util-decode-string": "2.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/mdast": "4.0.4",
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  }
}
