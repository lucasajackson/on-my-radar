{
  "name": "@onmyradar/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p scripts/tsconfig.json",
    "test": "vitest run",
    "migrate": "tsx src/db/migrate.ts",
    "vapid": "tsx src/services/push.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1118.0",
    "@aws-sdk/s3-request-presigner": "3.1118.0",
    "@hono/node-server": "2.1.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@onmyradar/contract": "workspace:*",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.14",
    "html-to-text": "10.0.1",
    "jose": "6.2.14",
    "mailauth": "7.1.0",
    "nodemailer": "10.1.4",
    "pg": "8.23.0",
    "pino": "9.14.0",
    "postal-mime": "4.1.4",
    "sanitize-html": "2.18.1",
    "saxes": "6.0.0",
    "sharp": "0.35.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/html-to-text": "9.0.4",
    "@types/node": "22.20.1",
    "@types/pg": "8.21.0",
    "@types/sanitize-html": "2.16.1",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
