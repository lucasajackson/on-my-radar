# On My Radar — configuration. Copy to .env for local development.
#
# In a deployment, set these in the process environment (or your orchestrator's
# config and secret objects) rather than a file. Never commit a filled-in .env.

NODE_ENV=development
PORT=3500
PUBLIC_URL=http://localhost:3500
LOG_LEVEL=debug

# --- required ---------------------------------------------------------------
DATABASE_URL=postgres://onmyradar:onmyradar@127.0.0.1:5432/on-my-radar
# 32+ characters. Signs session cookies and hashes every issued token.
SESSION_SECRET=change-me-to-at-least-thirty-two-characters
MIGRATE_ON_BOOT=1

# --- runtime limits ---------------------------------------------------------
# Each API/worker process has its own pool; budget the total across replicas.
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECT_TIMEOUT_MS=10000
# The deployment supplies the pod name so PostgreSQL can identify each caller.
DB_APPLICATION_NAME=onmyradar
# Aggregate request bytes; webhook ingest always retains its separate 64 KiB cap.
HTTP_BODY_LIMIT_BYTES=2097152
# Readiness withdraws before HTTP closes. The total deadline includes the drain.
# Keep the pod termination grace above SHUTDOWN_TIMEOUT_MS.
SHUTDOWN_DRAIN_MS=5000
SHUTDOWN_TIMEOUT_MS=25000

# --- GitLab (optional) ------------------------------------------------------
# Only for binding agent briefs to a GitLab repository. Unset means bindings show no
# link and read "not checked".
# GITLAB_URL=https://gitlab.example.com

# --- who gets in ------------------------------------------------------------
# SIGNUP_MODE=open (default) lets every new sign-in straight in.
# SIGNUP_MODE=waitlist queues them; these two lists skip the queue.
SIGNUP_MODE=open
ADMIN_EMAILS=you@example.com
AUTO_APPROVE_EMAILS=@example.com

# --- outbound mail ----------------------------------------------------------
# MAIL_PROVIDER is resend, smtp or console. Unset, it is Resend when
# RESEND_API_KEY is set and otherwise the log: in development the sign-in code
# is returned in the API response and shown on the login screen instead of
# being emailed. `console` is refused in production.
# MAIL_PROVIDER=smtp
# RESEND_API_KEY=re_...
# STARTTLS is required; add ?tls=none only for a relay you trust, e.g. a local
# mailpit: smtp://localhost:1025?tls=none
# SMTP_URL=smtp://user:password@smtp.example.com:587
# Defaults to `On My Radar <noreply@<host of PUBLIC_URL>>`; set it to an address your provider may send from.
# MAIL_FROM=On My Radar <noreply@example.com>

# --- object storage (S3-compatible) -------------------------------------------------
# Unset means attachments are disabled; everything else still works.
# Any S3-compatible store (MinIO, Garage, AWS S3, ...).
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=us-east-1
# S3_BUCKET=on-my-radar
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_FORCE_PATH_STYLE=true

# --- OIDC SSO (any standards-conforming provider) ---------------------------
# Unset means the SSO button is simply not shown. Register this redirect URI at the
# provider:  <PUBLIC_URL>/api/auth/oidc/callback
# With only the issuer, endpoints come from <issuer>/.well-known/openid-configuration
# (the ID token is verified against the discovery document's jwks_uri).
#
# OIDC_ISSUER_URL      The issuer, exactly as the provider names it. A trailing slash
#                      is tolerated.
# OIDC_CLIENT_ID / OIDC_CLIENT_SECRET   From the provider's client registration.
# OIDC_PROVIDER_NAME   The button label. Default: SSO.
# OIDC_SCOPES          Default: openid email profile.
# OIDC_TOKEN_AUTH_METHOD  basic (default, client_secret_basic) | post (credentials in
#                      the form body) | both. Never `both` unless a provider demands it:
#                      RFC 6749 forbids two methods at once.
# OIDC_USE_PKCE        S256 PKCE, default on. Turn off only for a provider that mishandles it.
# OIDC_HTTP_TIMEOUT_MS Timeout for the token and userinfo calls. Default 30000.
# OIDC_AUTHORIZATION_ENDPOINT, OIDC_TOKEN_ENDPOINT, OIDC_USERINFO_ENDPOINT, OIDC_JWKS_URI
#                      Explicit endpoints. Set authorization and token together to skip
#                      discovery; the JWKS URI is still needed to verify the ID token.
# OIDC_TRUST_IDP_EMAIL Operator assertion that the provider only releases verified
#                      addresses and users cannot edit them. Needed when it sends no
#                      `email_verified` claim. Default off.
# OIDC_ALLOW_MISSING_NONCE  Accept an ID token with no `nonce` claim. Default off; only
#                      for a provider that never echoes the nonce.
#
# Keycloak:   OIDC_ISSUER_URL=https://keycloak.example.com/realms/<realm>
#             (client: confidential, standard flow; defaults are right)
# Authentik:  OIDC_ISSUER_URL=https://authentik.example.com/application/o/<slug>/
#             (the trailing slash is part of the issuer; defaults are right)
# Okta:       OIDC_ISSUER_URL=https://<org>.okta.com/oauth2/default
#             (defaults are right; /oauth2/default is the default custom authorization server)
# Entra ID:   OIDC_ISSUER_URL=https://login.microsoftonline.com/<tenant-id>/v2.0
#             (defaults are right. Entra tokens carry no `email_verified` claim: set
#             OIDC_TRUST_IDP_EMAIL=1 only for a tenant whose users cannot choose their own email.)
# A provider with no usable discovery document (some NAS-hosted SSO servers): name the
#             endpoints yourself, relative to the provider's SSO base path (the issuer).
#             OIDC_ISSUER_URL=https://nas.example.com/webman/sso
#             OIDC_AUTHORIZATION_ENDPOINT=https://nas.example.com/webman/sso/SSOOauth.cgi
#             OIDC_TOKEN_ENDPOINT=https://nas.example.com/webman/sso/oauth/token
#             OIDC_USERINFO_ENDPOINT=https://nas.example.com/webman/sso/oauth/userinfo
#             OIDC_JWKS_URI=<the jwks_uri the provider publishes; the ID token cannot be verified without it>
#             OIDC_SCOPES=openid email   (if it does not support `profile`)
#             OIDC_TOKEN_AUTH_METHOD=post
#             OIDC_ALLOW_MISSING_NONCE=1   OIDC_TRUST_IDP_EMAIL=1   (if it sends neither claim)
# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# --- browser push (VAPID, RFC 8292) -----------------------------------------
# Unset means browser push is hidden; in-app and email notifications still work.
# Generate a matched pair — never write these by hand, the encoding matters:
#   pnpm --filter @onmyradar/server vapid
# The public key is not a secret (every subscribing browser gets it) but it is
# kept with its private half because a mismatched pair breaks push silently.
# Keep both in your secret store, not in a file.
# Rotating them invalidates every existing subscription — each browser has to
# grant permission again, with nothing to say why.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# RFC 8292 wants a contact a push service operator could reach. Defaults to mailto: the MAIL_FROM address.
# VAPID_SUBJECT=mailto:admin@example.com

# --- MCP --------------------------------------------------------------------
MCP_ENABLED=1
MCP_ALLOWED_REDIRECT_HOSTS=localhost,127.0.0.1,claude.ai,claude.com,*.claude.ai,*.claude.com,*.anthropic.com

# Inbound email capture: enable only after the Cloudflare Worker and routing rule
# are deployed. The same random 32+ character secret belongs in the Worker secret
# EMAIL_INGEST_SECRET; never use the Resend sending API key here.
EMAIL_CAPTURE_ENABLED=false
# The domain capture addresses live on; required to turn capture on.
# EMAIL_CAPTURE_DOMAIN=capture.example.com
# EMAIL_INGEST_SECRET=

# --- native push (APNs) -------------
# Configure separate environment keys; TestFlight uses production.
# Set TEAM_ID and both KEY_ID/PRIVATE_KEY for each enabled environment.
# APNS_TEAM_ID=
APNS_BUNDLE_ID=io.onmyradar.app
# APNS_PRODUCTION_KEY_ID=
# APNS_PRODUCTION_PRIVATE_KEY=
# APNS_SANDBOX_KEY_ID=
# APNS_SANDBOX_PRIVATE_KEY=
